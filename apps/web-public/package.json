{
    "name": "@hyperion/web-public",
    "version": "0.0.1",
    "author": "4thDEVisionTech",
    "description": "Hyperion Public Web UI Component",
    "type": "module",
    "private": true,
    "license": "ISC",
    "engines": {
        "bun": ">=1.3.9",
        "node": ">=24.13.1",
        "pnpm": ">=10.29.3"
    },
    "scripts": {
        "build": "vite build",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "deploy:staging": "vite build --mode=staging && wrangler deploy --outdir=dist --env=staging --config=wrangler-staging.toml",
        "deploy:prod": "vite build --mode=production && wrangler deploy --outdir=dist --env=production --config=wrangler-production.toml",
        "dev": "vite dev --host",
        "format": "prettier --write .",
        "lint": "prettier --check . && eslint .",
        "prepare": "svelte-kit sync || echo ''",
        "preview": "vite preview --host",
        "test:e2e": "playwright test"
    },
    "devDependencies": {
        "@hyperion/api-public": "workspace:*",
        "@hyperion/database": "workspace:*",
        "@hyperion/schema": "workspace:*",
        "@internationalized/date": "^3.11.0",
        "@lucide/svelte": "^0.563.1",
        "@playwright/test": "^1.58.2",
        "@sveltejs/adapter-static": "^3.0.10",
        "@sveltejs/kit": "^2.52.0",
        "@sveltejs/vite-plugin-svelte": "^6.2.4",
        "@tailwindcss/vite": "^4.1.18",
        "@tanstack/svelte-form": "^1.28.3",
        "@tanstack/svelte-query": "^6.0.18",
        "@tanstack/table-core": "^8.21.3",
        "@types/cloudflare-turnstile": "^0.2.2",
        "@vitest/browser": "^4.0.18",
        "@vitest/browser-playwright": "^4.0.18",
        "better-auth": "^1.4.18",
        "bits-ui": "^2.15.5",
        "clsx": "^2.1.1",
        "daisyui": "^5.5.18",
        "dayjs": "^1.11.19",
        "file-type": "^21.3.0",
        "hono": "^4.11.9",
        "ky": "^1.14.3",
        "mode-watcher": "^1.1.0",
        "nanoid": "^5.1.6",
        "p-queue": "^9.1.0",
        "playwright": "^1.58.2",
        "svelte": "^5.51.2",
        "svelte-check": "^4.4.0",
        "svelte-sonner": "^1.0.7",
        "tailwind-merge": "^3.4.1",
        "tailwind-variants": "^3.2.2",
        "tailwindcss": "^4.1.18",
        "tw-animate-css": "^1.4.0",
        "vite": "^7.3.1",
        "vite-imagetools": "^9.0.3",
        "vitest": "^4.0.18",
        "vitest-browser-svelte": "^2.0.2",
        "zod": "^4.3.6"
    }
}

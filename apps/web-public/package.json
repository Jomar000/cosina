{
    "name": "@hyperion/web-public",
    "version": "0.0.1",
    "author": "4thDEVisionTech",
    "description": "Hyperion Public Web UI Component",
    "type": "module",
    "private": true,
    "license": "ISC",
    "engines": {
        "bun": ">=1.3.10",
        "node": ">=24.14.0",
        "pnpm": ">=10.31.0"
    },
    "scripts": {
        "build": "vite build",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "deploy:staging": "vite build --mode=staging && wrangler deploy --outdir=dist --env=staging --config=wrangler-staging.toml",
        "deploy:prod": "vite build --mode=production && wrangler deploy --outdir=dist --env=production --config=wrangler-production.toml",
        "dev": "vite dev --host",
        "format": "prettier --write .",
        "lint": "prettier --check . && eslint .",
        "prepare": "svelte-kit sync || echo ''",
        "preview": "vite preview --host",
        "test:e2e": "playwright test"
    },
    "devDependencies": {
        "@hyperion/api-public": "workspace:*",
        "@hyperion/contracts": "workspace:*",
        "@hyperion/ui": "workspace:*",
        "@internationalized/date": "^3.12.0",
        "@lucide/svelte": "^0.577.0",
        "@playwright/test": "^1.58.2",
        "@sveltejs/adapter-static": "^3.0.10",
        "@sveltejs/kit": "^2.54.0",
        "@sveltejs/vite-plugin-svelte": "^6.2.4",
        "@tailwindcss/vite": "^4.2.1",
        "@tanstack/svelte-form": "^1.28.4",
        "@tanstack/svelte-query": "^6.1.0",
        "@tanstack/table-core": "^8.21.3",
        "@types/cloudflare-turnstile": "^0.2.2",
        "@vitest/browser": "^4.0.18",
        "@vitest/browser-playwright": "^4.0.18",
        "better-auth": "catalog:",
        "bits-ui": "^2.16.3",
        "clsx": "^2.1.1",
        "daisyui": "^5.5.19",
        "dayjs": "catalog:",
        "file-type": "^21.3.1",
        "hono": "catalog:",
        "ky": "^1.14.3",
        "mode-watcher": "^1.1.0",
        "nanoid": "catalog:",
        "p-queue": "^9.1.0",
        "playwright": "^1.58.2",
        "svelte": "^5.53.10",
        "svelte-check": "^4.4.5",
        "svelte-sonner": "^1.1.0",
        "tailwind-merge": "^3.5.0",
        "tailwind-variants": "^3.2.2",
        "tailwindcss": "^4.2.1",
        "tw-animate-css": "^1.4.0",
        "vite": "^7.3.1",
        "vite-imagetools": "^10.0.0",
        "vitest": "^4.0.18",
        "vitest-browser-svelte": "^2.0.2",
        "zod": "catalog:"
    }
}

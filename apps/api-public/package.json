{
    "name": "@hyperion/api-public",
    "version": "0.0.1",
    "author": "4thDEVisionTech",
    "description": "Hyperion Public API Component",
    "type": "module",
    "private": true,
    "license": "ISC",
    "engines": {
        "bun": ">=1.3.9",
        "node": ">=24.13.1",
        "pnpm": ">=10.30.2"
    },
    "scripts": {
        "build": "wrangler deploy --outdir=./dist/$worker --dry-run --env=",
        "dev": "wrangler dev",
        "deploy:staging": "wrangler deploy --minify --outdir=./dist/$worker --env=staging --config=wrangler-staging.toml",
        "deploy:prod": "wrangler deploy --minify --outdir=./dist/$worker --env=production --config=wrangler-production.toml",
        "format": "prettier --write .",
        "lint": "prettier --check . && eslint .",
        "secret:staging": "wrangler secret bulk .dev.vars.staging --env=staging --config=wrangler-staging.toml",
        "secret:prod": "wrangler secret bulk .dev.vars.production --env=production --config=wrangler-production.toml",
        "test": "pnpm run migrate:test && vitest --run"
    },
    "dependencies": {
        "@hyperion/contracts": "workspace:*",
        "@hyperion/database": "workspace:*",
        "@noble/hashes": "^2.0.1",
        "aws4fetch": "^1.0.20",
        "better-auth": "^1.4.19",
        "dayjs": "^1.11.19",
        "drizzle-orm": "beta",
        "hono": "^4.12.2",
        "nanoid": "^5.1.6",
        "resend": "^6.9.2",
        "uuid": "^13.0.0",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@cloudflare/vitest-pool-workers": "^0.12.17",
        "@vitest/coverage-istanbul": "^3.2.4",
        "@vitest/runner": "^3.2.4",
        "@vitest/snapshot": "^3.2.4",
        "vite": "^7.3.1",
        "vitest": "^3.2.4"
    },
    "exports": {
        ".": {
            "types": "./dist/core/index.d.ts",
            "default": "./dist/core/index.js"
        }
    }
}

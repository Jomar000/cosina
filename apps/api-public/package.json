{
    "name": "@hyperion/api-public",
    "version": "0.0.1",
    "author": "4thDEVisionTech",
    "description": "Hyperion Public API Component",
    "type": "module",
    "private": true,
    "license": "ISC",
    "engines": {
        "node": ">=24.16.0",
        "pnpm": ">=11.8.0"
    },
    "scripts": {
        "build": "wrangler deploy --outdir=./dist/$worker --dry-run --env=",
        "build:force": "tsc --build ./tsconfig.build.json --clean && pnpm run build",
        "check": "tsc --noEmit",
        "deploy:prod": "tsc --build ./tsconfig.build.json --clean && wrangler deploy --minify --outdir=./dist/$worker --env=production --config=wrangler-production.toml",
        "deploy:staging": "tsc --build ./tsconfig.build.json --clean && wrangler deploy --minify --outdir=./dist/$worker --env=staging --config=wrangler-staging.toml",
        "dev": "wrangler dev",
        "format": "prettier --write . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
        "lint": "prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore && eslint .",
        "secret:prod": "wrangler secret bulk .dev.vars.production --env=production --config=wrangler-production.toml",
        "secret:staging": "wrangler secret bulk .dev.vars.staging --env=staging --config=wrangler-staging.toml",
        "test": "pnpm run test:con && pnpm run test:seq",
        "test:con": "pnpm --filter=@hyperion/database run migrate:test && vitest run --project=concurrent-test-files",
        "test:seq": "pnpm --filter=@hyperion/database run migrate:test && vitest run --project=sequential-test-files",
        "test:ui": "echo Use `test:ui:con` or `test:ui:seq` instead",
        "test:ui:con": "pnpm --filter=@hyperion/database run migrate:test && vitest --ui --project=concurrent-test-files",
        "test:ui:seq": "pnpm --filter=@hyperion/database run migrate:test && vitest --ui --project=sequential-test-files"
    },
    "README": "This is a private package bundled by wrangler — the deps/devDeps split has no effect on its own build. dependencies lists only what consumers need for type resolution of the exported Hono routes. Server-only packages live in devDependencies to avoid leaking them transitively into frontend apps.",
    "dependencies": {
        "@hyperion/types": "workspace:*",
        "@hyperion/validator": "workspace:*",
        "hono": "catalog:",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@better-auth/drizzle-adapter": "catalog:",
        "@cloudflare/vitest-pool-workers": "catalog:",
        "@hono/zod-validator": "catalog:",
        "@hyperion/database": "workspace:*",
        "@noble/hashes": "catalog:",
        "@vitest/coverage-istanbul": "catalog:",
        "@vitest/runner": "catalog:",
        "@vitest/snapshot": "catalog:",
        "@vitest/ui": "catalog:",
        "aws4fetch": "catalog:",
        "better-auth": "catalog:",
        "dayjs": "catalog:",
        "drizzle-orm": "catalog:",
        "nanoid": "catalog:",
        "resend": "catalog:",
        "uuid": "catalog:",
        "vite": "catalog:",
        "vitest": "catalog:"
    },
    "exports": {
        "./api/admin": {
            "types": "./dist/core/route/api/admin/index.d.ts",
            "default": "./dist/core/route/api/admin/index.js"
        },
        "./api/auth": {
            "types": "./dist/core/route/api/auth.d.ts",
            "default": "./dist/core/route/api/auth.js"
        },
        "./api/objectStorage": {
            "types": "./dist/core/route/api/objectStorage/index.d.ts",
            "default": "./dist/core/route/api/objectStorage/index.js"
        },
        "./api/user": {
            "types": "./dist/core/route/api/user/index.d.ts",
            "default": "./dist/core/route/api/user/index.js"
        },
        "./api/heartbeat": {
            "types": "./dist/core/route/api/heartbeat.d.ts",
            "default": "./dist/core/route/api/heartbeat.js"
        }
    }
}

{
    "name": "@hyperion/web-backoffice",
    "version": "0.0.1",
    "author": "4thDEVisionTech",
    "description": "Hyperion Backoffice Web UI Component",
    "type": "module",
    "private": true,
    "license": "ISC",
    "engines": {
        "node": ">=24.15.0",
        "pnpm": ">=11.5.0"
    },
    "scripts": {
        "build": "vite build",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "deploy:prod": "vite build --mode=production && wrangler deploy --outdir=dist --env=production --config=wrangler-production.toml",
        "deploy:staging": "vite build --mode=staging && wrangler deploy --outdir=dist --env=staging --config=wrangler-staging.toml",
        "dev": "vite dev --host",
        "format": "prettier --write .",
        "lint": "prettier --check . && eslint .",
        "prepare": "svelte-kit sync || echo ''",
        "preview": "vite preview --host",
        "test:e2e": "playwright test"
    },
    "devDependencies": {
        "@hyperion/api-backoffice": "workspace:*",
        "@hyperion/types": "workspace:*",
        "@hyperion/ui": "workspace:*",
        "@hyperion/validator": "workspace:*",
        "@lucide/svelte": "catalog:",
        "@playwright/test": "catalog:",
        "@sveltejs/adapter-static": "catalog:",
        "@sveltejs/kit": "catalog:",
        "@sveltejs/vite-plugin-svelte": "catalog:",
        "@tailwindcss/vite": "catalog:",
        "@tanstack/svelte-form": "catalog:",
        "@tanstack/svelte-query": "catalog:",
        "@types/cloudflare-turnstile": "catalog:",
        "@vitest/browser": "catalog:",
        "@vitest/browser-playwright": "catalog:",
        "dayjs": "catalog:",
        "apexcharts": "^4.7.0",
        "file-type": "catalog:",
        "hono": "catalog:",
        "ky": "catalog:",
        "mode-watcher": "catalog:",
        "nanoid": "catalog:",
        "p-queue": "catalog:",
        "perfect-debounce": "catalog:",
        "playwright": "catalog:",
        "svelte": "catalog:",
        "svelte-check": "catalog:",
        "svelte-sonner": "catalog:",
        "tailwindcss": "catalog:",
        "vite": "catalog:",
        "vite-imagetools": "catalog:",
        "vitest": "catalog:",
        "vitest-browser-svelte": "catalog:",
        "zod": "catalog:"
    }
}

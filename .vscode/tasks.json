// https://code.visualstudio.com/docs/terminal/basics#_automating-terminals-with-tasks
{
    "version": "2.0.0",
    "presentation": {
        "echo": false,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": true
    },
    "tasks": [
        {
            "label": "Launch Workspace Terminals",
            "dependsOn": [
                "root",
                "validator",
                "api-public",
                "web-public"
            ],
            "runOptions": {
                "runOn": "folderOpen"
            }
        },
        {
            "label": "root",
            "icon": {
                "id": "terminal",
                "color": "terminal.ansiGreen"
            },
            "type": "shell",
            "hide": true,
            "command": "bash",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true
        },
        {
            "label": "validator",
            "icon": {
                "id": "terminal",
                "color": "terminal.ansiGreen"
            },
            "type": "shell",
            "hide": true,
            "command": "bash",
            "options": {
                "cwd": "${workspaceFolder}/packages/validator"
            },
            "isBackground": true
        },
        {
            "label": "api-public",
            "icon": {
                "id": "terminal",
                "color": "terminal.ansiGreen"
            },
            "type": "shell",
            "hide": true,
            "command": "bash",
            "options": {
                "cwd": "${workspaceFolder}/apps/api/public"
            },
            "isBackground": true
        },
        {
            "label": "web-public",
            "icon": {
                "id": "terminal",
                "color": "terminal.ansiGreen"
            },
            "type": "shell",
            "hide": true,
            "command": "bash",
            "options": {
                "cwd": "${workspaceFolder}/apps/web/public"
            },
            "isBackground": true
        }
    ]
}

{
    "name": "hyperion",
    "version": "0.0.1",
    "author": "4thDEVisionTech",
    "description": "Hyperion",
    "type": "module",
    "private": true,
    "license": "ISC",
    "engines": {
        "node": ">=24.14.1",
        "pnpm": ">=10.33.2"
    },
    "scripts": {
        "dev": "pnpm run --recursive --parallel --if-present dev",
        "build": "pnpm run --recursive --stream --if-present build",
        "format": "pnpm run --recursive --stream --if-present format",
        "lint": "pnpm run --recursive --stream --if-present lint",
        "prepare": "pnpm exec husky",
        "test": "echo 'Tests must be run per-app to ensure a clean DB state per session'"
    },
    "devDependencies": {
        "@changesets/cli": "^2.31.0",
        "@eslint/compat": "^2.0.5",
        "@eslint/js": "^10.0.1",
        "@types/node": "^24.12.2",
        "eslint": "^10.3.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-svelte": "^3.17.1",
        "globals": "^17.6.0",
        "husky": "^9.1.7",
        "prettier": "^3.8.3",
        "prettier-plugin-multiline-arrays": "^4.1.7",
        "prettier-plugin-svelte": "^3.5.1",
        "prettier-plugin-tailwindcss": "^0.8.0",
        "tsx": "^4.21.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.59.1",
        "wrangler": "^4.87.0"
    },
    "pnpm": {
        "allowedDeprecatedVersions": {
            "@esbuild-kit/core-utils": "*",
            "@esbuild-kit/esm-loader": "*",
            "prebuild-install": "*"
        },
        "overrides": {
            "@better-auth/drizzle-adapter>drizzle-orm": "1.0.0-beta.22",
            "better-auth>drizzle-orm": "1.0.0-beta.22",
            "esbuild": "^0.28.0",
            "globals": "^17.5.0",
            "uuid@<12": "^11.0.0",
            "uuid@>=12": "^14.0.0"
        },
        "peerDependencyRules": {
            "allowedVersions": {
                "typescript": "^6.0.0"
            },
            "ignoreMissing": []
        }
    }
}

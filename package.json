{
    "name": "hyperion",
    "version": "0.0.1",
    "author": "4thDEVisionTech",
    "description": "Hyperion",
    "type": "module",
    "private": true,
    "license": "ISC",
    "engines": {
        "pnpm": ">=10.18.3"
    },
    "scripts": {
        "build": "pnpm --recursive --stream build",
        "format": "prettier --write .",
        "lint": "prettier --check . && eslint ."
    },
    "devDependencies": {
        "@changesets/cli": "^2.29.7",
        "@eslint/js": "^9.37.0",
        "@types/node": "^24.8.1",
        "@typescript-eslint/eslint-plugin": "^8.46.1",
        "@typescript-eslint/parser": "^8.46.1",
        "eslint": "^9.37.0",
        "eslint-plugin-svelte": "^3.12.4",
        "globals": "^16.4.0",
        "husky": "^9.1.7",
        "prettier": "^3.6.2",
        "prettier-plugin-multiline-arrays": "^4.0.3",
        "prettier-plugin-svelte": "^3.4.0",
        "prettier-plugin-tailwindcss": "^0.7.0",
        "svelte-eslint-parser": "^1.3.3",
        "typescript": "^5.9.3",
        "wrangler": "^4.43.0"
    },
    "pnpm": {
        "allowedDeprecatedVersions": {
            "q": "*",
            "rimraf": "*"
        },
        "overrides": {
            "@sveltejs/kit>cookie": "^0.7.2",
            "drizzle-kit>@esbuild-kit/core-utils": "npm:tsx@^4.20.6",
            "drizzle-kit>@esbuild-kit/esm-loader": "npm:tsx@^4.20.6",
            "esbuild": "0.25.11"
        },
        "peerDependencyRules": {
            "allowedVersions": {
                "typescript": "^5.9.2"
            },
            "ignoreMissing": [
                "@types/node"
            ]
        }
    }
}

{
    "name": "hyperion",
    "version": "0.0.1",
    "author": "4thDEVisionTech",
    "description": "Hyperion",
    "type": "module",
    "private": true,
    "license": "ISC",
    "engines": {
        "bun": ">=1.3.9",
        "node": ">=24.13.1",
        "pnpm": ">=10.30.3"
    },
    "scripts": {
        "build": "pnpm run --recursive --stream build",
        "format": "pnpm run --recursive --stream format",
        "lint": "pnpm run --recursive --stream lint",
        "prepare": "pnpm exec husky"
    },
    "devDependencies": {
        "@changesets/cli": "^2.30.0",
        "@eslint/compat": "^2.0.2",
        "@eslint/js": "^10.0.1",
        "@types/node": "^24.11.2",
        "eslint": "^10.0.2",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-svelte": "^3.15.0",
        "globals": "^17.4.0",
        "husky": "^9.1.7",
        "prettier": "^3.8.1",
        "prettier-plugin-multiline-arrays": "^4.1.4",
        "prettier-plugin-svelte": "^3.5.1",
        "prettier-plugin-tailwindcss": "^0.7.2",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.56.1",
        "wrangler": "^4.71.0"
    },
    "pnpm": {
        "allowedDeprecatedVersions": {
            "prebuild-install": "*",
            "q": "*",
            "rimraf": "*"
        },
        "overrides": {
            "@sveltejs/kit>cookie": "^0.7.2",
            "drizzle-kit>@esbuild-kit/core-utils": "npm:tsx@^4.21.0",
            "drizzle-kit>@esbuild-kit/esm-loader": "npm:tsx@^4.21.0",
            "globals": "^17.3.0",
            "esbuild": "^0.27.3",
            "test-exclude>glob": "^13.0.1"
        },
        "peerDependencyRules": {
            "allowedVersions": {
                "@typescript-eslint/eslint-plugin>eslint": "^10.0.0",
                "@typescript-eslint/parser>eslint": "^10.0.0",
                "@typescript-eslint/type-utils>eslint": "^10.0.0",
                "@typescript-eslint/utils>eslint": "^10.0.0",
                "typescript-eslint>eslint": "^10.0.0",
                "typescript": "^5.9.2"
            },
            "ignoreMissing": [
                "@types/node"
            ]
        }
    }
}

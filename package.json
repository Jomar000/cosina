{
    "name": "hyperion",
    "version": "0.0.1",
    "author": "4thDEVisionTech",
    "description": "Hyperion",
    "type": "module",
    "private": true,
    "license": "ISC",
    "engines": {
        "pnpm": ">=10.15.0"
    },
    "scripts": {
        "build": "pnpm --recursive --stream build",
        "format": "prettier --write .",
        "lint": "eslint ."
    },
    "devDependencies": {
        "@changesets/cli": "^2.29.6",
        "@eslint/js": "^9.34.0",
        "@types/node": "^24.3.0",
        "@typescript-eslint/eslint-plugin": "^8.41.0",
        "@typescript-eslint/parser": "^8.41.0",
        "eslint": "^9.34.0",
        "eslint-plugin-svelte": "^3.11.0",
        "husky": "^9.1.7",
        "prettier": "^3.6.2",
        "prettier-plugin-multiline-arrays": "^4.0.3",
        "prettier-plugin-svelte": "^3.4.0",
        "prettier-plugin-tailwindcss": "^0.6.14",
        "svelte-eslint-parser": "^1.3.1",
        "typescript": "^5.9.2",
        "wrangler": "^4.33.1"
    },
    "pnpm": {
        "allowedDeprecatedVersions": {
            "q": "*",
            "rimraf": "*"
        },
        "overrides": {
            "@sveltejs/kit>cookie": "^0.7.2",
            "better-auth>@noble/ciphers": "^1.3.0",
            "better-auth>jose": "^6.1.0",
            "drizzle-kit>@esbuild-kit/core-utils": "npm:tsx@^4.20.5",
            "drizzle-kit>@esbuild-kit/esm-loader": "npm:tsx@^4.20.5",
            "esbuild": "0.25.9"
        },
        "peerDependencyRules": {
            "allowedVersions": {
                "typescript": "^5.9.2"
            },
            "ignoreMissing": [
                "@types/node"
            ]
        }
    }
}

{
    "name": "hyperion",
    "version": "0.0.1",
    "author": "4thDEVisionTech",
    "description": "Hyperion",
    "type": "module",
    "private": true,
    "license": "ISC",
    "engines": {
        "pnpm": ">=10.23.0",
        "node": ">=24.11.1"
    },
    "scripts": {
        "build": "pnpm --recursive --stream build",
        "format": "prettier --write .",
        "lint": "prettier --check . && eslint .",
        "prepare": "pnpm husky"
    },
    "devDependencies": {
        "@changesets/cli": "^2.29.8",
        "@eslint/compat": "^2.0.0",
        "@eslint/js": "^9.39.1",
        "@types/node": "^24.10.2",
        "eslint": "^9.39.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-svelte": "^3.13.1",
        "globals": "^16.5.0",
        "husky": "^9.1.7",
        "prettier": "3.6.2",
        "prettier-plugin-multiline-arrays": "^4.0.5",
        "prettier-plugin-svelte": "^3.4.0",
        "prettier-plugin-tailwindcss": "^0.7.2",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.49.0",
        "wrangler": "^4.53.0"
    },
    "pnpm": {
        "allowedDeprecatedVersions": {
            "q": "*",
            "rimraf": "*"
        },
        "overrides": {
            "@sveltejs/kit>cookie": "^0.7.2",
            "drizzle-kit>@esbuild-kit/core-utils": "npm:tsx@^4.20.6",
            "drizzle-kit>@esbuild-kit/esm-loader": "npm:tsx@^4.20.6",
            "esbuild": "0.27.1"
        },
        "peerDependencyRules": {
            "allowedVersions": {
                "typescript": "^5.9.2"
            },
            "ignoreMissing": [
                "@types/node"
            ]
        }
    }
}

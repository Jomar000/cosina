{
    "name": "hyperion",
    "version": "0.0.1",
    "author": "4thDEVisionTech",
    "description": "Hyperion",
    "type": "module",
    "private": true,
    "license": "ISC",
    "engines": {
        "pnpm": ">=10.28.0",
        "node": ">=24.12.0"
    },
    "scripts": {
        "build": "pnpm --recursive --stream build",
        "format": "prettier --write .",
        "lint": "prettier --check . && eslint .",
        "prepare": "pnpm husky"
    },
    "devDependencies": {
        "@changesets/cli": "^2.29.8",
        "@eslint/compat": "^2.0.1",
        "@eslint/js": "^9.39.2",
        "@types/node": "^24.10.6",
        "eslint": "^9.39.2",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-svelte": "^3.14.0",
        "globals": "^17.0.0",
        "husky": "^9.1.7",
        "prettier": "^3.7.4",
        "prettier-plugin-multiline-arrays": "^4.1.3",
        "prettier-plugin-svelte": "^3.4.1",
        "prettier-plugin-tailwindcss": "^0.7.2",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.52.0",
        "wrangler": "^4.58.0"
    },
    "pnpm": {
        "allowedDeprecatedVersions": {
            "q": "*",
            "rimraf": "*"
        },
        "overrides": {
            "@sveltejs/kit>cookie": "^0.7.2",
            "drizzle-kit>@esbuild-kit/core-utils": "npm:tsx@^4.20.6",
            "drizzle-kit>@esbuild-kit/esm-loader": "npm:tsx@^4.20.6",
            "esbuild": "0.27.2"
        },
        "peerDependencyRules": {
            "allowedVersions": {
                "better-auth>drizzle-orm": "^0.41.0 || ^0.45.0",
                "better-auth>vitest": "^3.2.4 || ^4.0.15",
                "typescript": "^5.9.2"
            },
            "ignoreMissing": [
                "@types/node"
            ]
        }
    }
}

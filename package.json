{
    "name": "hyperion",
    "version": "0.0.1",
    "author": "4thDEVisionTech",
    "description": "Hyperion",
    "type": "module",
    "private": true,
    "license": "ISC",
    "engines": {
        "node": ">=24.16.0",
        "pnpm": ">=11.5.2"
    },
    "scripts": {
        "dev": "pnpm run --recursive --parallel --if-present dev",
        "build": "pnpm run --recursive --stream --if-present build",
        "format": "pnpm run --recursive --stream --if-present format",
        "lint": "pnpm run --recursive --stream --if-present lint",
        "prepare": "pnpm exec husky",
        "test": "echo 'Tests must be run per-app to ensure a clean DB state per session'"
    },
    "devDependencies": {
        "@changesets/cli": "^2.31.0",
        "@eslint/compat": "^2.1.0",
        "@eslint/js": "^10.0.1",
        "@types/node": "^24.13.1",
        "eslint": "^10.4.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-better-tailwindcss": "^4.5.0",
        "eslint-plugin-svelte": "^3.19.0",
        "globals": "^17.6.0",
        "husky": "^9.1.7",
        "prettier": "^3.8.3",
        "prettier-plugin-multiline-arrays": "^4.1.9",
        "prettier-plugin-svelte": "^4.1.0",
        "prettier-plugin-tailwindcss": "^0.8.0",
        "tsx": "^4.22.4",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.61.0",
        "wrangler": "^4.98.0"
    }
}

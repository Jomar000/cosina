{
    "name": "@hyperion/backend",
    "version": "0.0.1",
    "author": "4thDEVisionTech",
    "description": "Hyperion Backend Component",
    "type": "module",
    "private": true,
    "license": "ISC",
    "engines": {
        "bun": ">=1.3.8",
        "node": ">=24.13.0",
        "pnpm": ">=10.28.2"
    },
    "scripts": {
        "dev": "wrangler dev",
        "build": "wrangler deploy --outdir=./dist/$worker --dry-run --env=",
        "test": "pnpm run migrate:test && vitest --run",
        "deploy:staging": "wrangler deploy --minify --outdir=./dist/$worker --env=staging --config=wrangler-staging.toml",
        "deploy:prod": "wrangler deploy --minify --outdir=./dist/$worker --env=production --config=wrangler-production.toml",
        "migrate:dev": "bun ./src/db/pg/bootstrap.ts dev || node ./src/db/pg/bootstrap.ts dev",
        "migrate:test": "bun ./src/db/pg/bootstrap.ts test || node ./src/db/pg/bootstrap.ts dev",
        "migrate:staging": "drizzle-kit migrate --config=drizzle-staging.config.ts",
        "migrate:prod": "drizzle-kit migrate --config=drizzle-production.config.ts",
        "secret:staging": "wrangler secret bulk .dev.vars.staging --env=staging --config=wrangler-staging.toml",
        "secret:prod": "wrangler secret bulk .dev.vars.production --env=production --config=wrangler-production.toml"
    },
    "dependencies": {
        "@hyperion/validator": "workspace:*",
        "@noble/hashes": "^2.0.1",
        "aws4fetch": "^1.0.20",
        "better-auth": "^1.4.18",
        "dayjs": "^1.11.19",
        "drizzle-orm": "^0.45.1",
        "hono": "^4.11.9",
        "nanoid": "^5.1.6",
        "postgres": "^3.4.8",
        "resend": "^6.9.1",
        "uuid": "^13.0.0",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@cloudflare/vitest-pool-workers": "^0.12.10",
        "@vitest/coverage-istanbul": "^3.2.4",
        "@vitest/runner": "^3.2.4",
        "@vitest/snapshot": "^3.2.4",
        "drizzle-kit": "^0.31.8",
        "smol-toml": "^1.6.0",
        "vite": "^7.3.1",
        "vitest": "^3.2.4"
    },
    "exports": {
        ".": {
            "types": "./dist/core/index.d.ts",
            "default": "./dist/core/index.js"
        }
    }
}

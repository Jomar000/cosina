{
    "name": "@hyperion/backend",
    "version": "0.0.1",
    "author": "4thDEVisionTech",
    "description": "Hyperion Backend Component",
    "type": "module",
    "private": true,
    "license": "ISC",
    "engines": {
        "pnpm": ">=10.21.0",
        "node": ">=24.11.0"
    },
    "scripts": {
        "dev": "wrangler dev",
        "build": "wrangler deploy --outdir=dist --dry-run --env=",
        "test": "pnpm run migrate:test && vitest --run",
        "deploy:staging": "wrangler deploy --minify --outdir=dist --env=staging",
        "deploy:prod": "wrangler deploy --minify --outdir=dist --env=production",
        "migrate:dev": "node ./src/db/pg/bootstrap.ts dev",
        "migrate:test": "node ./src/db/pg/bootstrap.ts test",
        "migrate:staging": "drizzle-kit migrate --config=drizzle-staging.config.ts",
        "migrate:prod": "drizzle-kit migrate --config=drizzle-production.config.ts",
        "secret:staging": "wrangler secret bulk .dev.vars.staging --env=staging",
        "secret:prod": "wrangler secret bulk .dev.vars.production --env=production"
    },
    "dependencies": {
        "@hyperion/validator": "workspace:*",
        "@noble/hashes": "^2.0.1",
        "aws4fetch": "^1.0.20",
        "better-auth": "^1.3.34",
        "dayjs": "^1.11.19",
        "drizzle-orm": "^0.44.7",
        "hono": "^4.10.6",
        "nanoid": "^5.1.6",
        "postgres": "^3.4.7",
        "uuid": "^13.0.0",
        "zod": "^4.1.12"
    },
    "devDependencies": {
        "@cloudflare/vitest-pool-workers": "^0.10.7",
        "@vitest/coverage-istanbul": "^3.2.4",
        "@vitest/runner": "^3.2.4",
        "@vitest/snapshot": "^3.2.4",
        "drizzle-kit": "^0.31.7",
        "smol-toml": "^1.5.2",
        "vite": "^7.2.2",
        "vitest": "^3.2.4"
    }
}

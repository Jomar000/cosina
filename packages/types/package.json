{
    "name": "@hyperion/types",
    "version": "0.0.1",
    "author": "4thDEVisionTech",
    "description": "Hyperion Types Component",
    "type": "module",
    "private": true,
    "license": "ISC",
    "engines": {
        "node": ">=24.14.0",
        "pnpm": ">=10.32.1"
    },
    "scripts": {
        "build": "tsc --build ./tsconfig.json",
        "format": "prettier --write .",
        "lint": "prettier --check . && eslint .",
        "prepare": "pnpm build"
    },
    "dependencies": {
        "zod": "catalog:"
    },
    "exports": {
        "./shared": {
            "types": "./dist/shared/index.d.ts",
            "default": "./dist/shared/index.js"
        },
        "./public": {
            "types": "./dist/public/index.d.ts",
            "default": "./dist/public/index.js"
        }
    }
}

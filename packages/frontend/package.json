{
    "name": "@hyperion/frontend",
    "version": "0.0.1",
    "author": "4thDEVisionTech",
    "description": "Hyperion Frontend Component",
    "type": "module",
    "private": true,
    "license": "ISC",
    "engines": {
        "pnpm": ">=10.18.0"
    },
    "scripts": {
        "dev": "vite dev --host",
        "build": "vite build",
        "preview": "vite preview --host",
        "deploy:staging": "vite build --mode=staging && wrangler deploy --outdir=dist --env=staging",
        "deploy:prod": "vite build --mode=production && wrangler deploy --outdir=dist --env=production",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "test:comp": "vitest --run component",
        "test:e2e": "playwright"
    },
    "devDependencies": {
        "@hyperion/validator": "workspace:*",
        "@phosphor-icons/web": "^2.1.2",
        "@playwright/test": "^1.55.1",
        "@sveltejs/adapter-static": "^3.0.10",
        "@sveltejs/kit": "^2.43.8",
        "@sveltejs/vite-plugin-svelte": "^6.2.1",
        "@tailwindcss/vite": "^4.1.14",
        "@tanstack/svelte-form": "^1.23.5",
        "@tanstack/svelte-query": "^6.0.0",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/svelte": "^5.2.8",
        "@types/cloudflare-turnstile": "^0.2.2",
        "@vitest/ui": "^3.2.4",
        "better-auth": "^1.3.26",
        "bits-ui": "^2.11.4",
        "daisyui": "^5.1.27",
        "dayjs": "^1.11.18",
        "flowbite": "^3.1.2",
        "happy-dom": "^19.0.2",
        "nanoid": "^5.1.6",
        "svelte": "^5.39.8",
        "svelte-check": "^4.3.2",
        "tailwindcss": "^4.1.14",
        "tslib": "^2.8.1",
        "vite": "^7.1.9",
        "vite-imagetools": "^8.0.0",
        "vitest": "^3.2.4",
        "zod": "^4.1.11"
    }
}

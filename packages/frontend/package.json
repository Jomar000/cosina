{
    "name": "@hyperion/frontend",
    "version": "0.0.1",
    "author": "4thDEVisionTech",
    "description": "Hyperion Frontend Component",
    "type": "module",
    "private": true,
    "license": "ISC",
    "engines": {
        "pnpm": ">=10.21.0",
        "node": ">=24.11.0"
    },
    "scripts": {
        "dev": "vite dev --host",
        "build": "vite build",
        "preview": "vite preview --host",
        "prepare": "svelte-kit sync || echo ''",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "test:e2e": "playwright test",
        "deploy:staging": "vite build --mode=staging && wrangler deploy --outdir=dist --env=staging",
        "deploy:prod": "vite build --mode=production && wrangler deploy --outdir=dist --env=production"
    },
    "devDependencies": {
        "@hyperion/validator": "workspace:*",
        "@internationalized/date": "^3.10.0",
        "@lucide/svelte": "^0.554.0",
        "@playwright/test": "^1.56.1",
        "@sveltejs/adapter-static": "^3.0.10",
        "@sveltejs/kit": "^2.48.5",
        "@sveltejs/vite-plugin-svelte": "^6.2.1",
        "@tailwindcss/vite": "^4.1.17",
        "@tanstack/svelte-form": "^1.25.0",
        "@tanstack/svelte-query": "^6.0.8",
        "@tanstack/table-core": "^8.21.3",
        "@types/cloudflare-turnstile": "^0.2.2",
        "@vitest/browser": "^4.0.10",
        "@vitest/browser-playwright": "^4.0.10",
        "better-auth": "^1.3.34",
        "bits-ui": "^2.14.4",
        "clsx": "^2.1.1",
        "daisyui": "^5.5.5",
        "dayjs": "^1.11.19",
        "file-type": "^21.1.1",
        "ky": "^1.14.0",
        "mode-watcher": "^1.1.0",
        "nanoid": "^5.1.6",
        "p-queue": "^9.0.1",
        "playwright": "^1.56.1",
        "svelte": "^5.43.12",
        "svelte-check": "^4.3.4",
        "svelte-sonner": "^1.0.6",
        "tailwind-merge": "^3.4.0",
        "tailwind-variants": "^3.1.1",
        "tailwindcss": "^4.1.17",
        "tw-animate-css": "^1.4.0",
        "vite": "^7.2.4",
        "vite-imagetools": "^9.0.0",
        "vitest": "^4.0.10",
        "vitest-browser-svelte": "^2.0.1",
        "zod": "^4.1.12"
    }
}

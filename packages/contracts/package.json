{
    "name": "@hyperion/contracts",
    "version": "0.0.1",
    "author": "4thDEVisionTech",
    "description": "Hyperion Contracts Component",
    "type": "module",
    "private": true,
    "license": "ISC",
    "engines": {
        "bun": ">=1.3.10",
        "node": ">=24.14.0",
        "pnpm": ">=10.31.0"
    },
    "scripts": {
        "build": "tsc --build ./tsconfig.json",
        "format": "prettier --write .",
        "lint": "prettier --check . && eslint .",
        "prepare": "pnpm build"
    },
    "dependencies": {
        "dayjs": "catalog:",
        "zod": "catalog:"
    },
    "exports": {
        "./types": {
            "types": "./dist/types/index.d.ts",
            "default": "./dist/types/index.js"
        },
        "./validator/app": {
            "types": "./dist/validator/app/index.d.ts",
            "default": "./dist/validator/app/index.js"
        },
        "./validator/app/auth": {
            "types": "./dist/validator/app/auth.schema.d.ts",
            "default": "./dist/validator/app/auth.schema.js"
        },
        "./validator/app/admin/user": {
            "types": "./dist/validator/app/admin/user/index.d.ts",
            "default": "./dist/validator/app/admin/user/index.js"
        },
        "./validator/app/objectStorage": {
            "types": "./dist/validator/app/objectStorage.schema.d.ts",
            "default": "./dist/validator/app/objectStorage.schema.js"
        },
        "./validator/app/user": {
            "types": "./dist/validator/app/user/index.d.ts",
            "default": "./dist/validator/app/user/index.js"
        },
        "./validator/shared": {
            "types": "./dist/validator/shared/index.d.ts",
            "default": "./dist/validator/shared/index.js"
        }
    }
}

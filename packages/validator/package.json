            "default": "./dist/backoffice/admin/settings/index.js"
        },
        "./backoffice/admin/user": {
            "types": "./dist/backoffice/admin/user/index.d.ts",
            "default": "./dist/backoffice/admin/user/index.js"
        },
        "./backoffice/objectStorage": {
            "types": "./dist/backoffice/objectStorage.schema.d.ts",
            "default": "./dist/backoffice/objectStorage.schema.js"

{
    "name": "@hyperion/validator",
    "version": "0.0.1",
    "author": "4thDEVisionTech",
    "description": "Hyperion Validator Component",
    "type": "module",
    "private": true,
    "license": "ISC",
    "engines": {
        "node": ">=24.16.0",
        "pnpm": ">=11.9.0"
    },
    "scripts": {
        "build": "tsc --build ./tsconfig.json",
        "build:force": "tsc --build ./tsconfig.json --clean && pnpm run build",
        "format": "eslint . --fix && prettier --write . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
        "lint": "prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore && eslint .",
        "prepare": "pnpm build"
    },
    "dependencies": {
        "@hyperion/types": "workspace:*",
        "zod": "catalog:"
    },
    "exports": {
        "./backoffice": {
            "types": "./dist/backoffice/index.d.ts",
            "default": "./dist/backoffice/index.js"
        },
        "./backoffice/auth": {
            "types": "./dist/backoffice/auth.schema.d.ts",
            "default": "./dist/backoffice/auth.schema.js"
        },
        "./backoffice/admin": {
            "types": "./dist/backoffice/admin/index.d.ts",
            "default": "./dist/backoffice/admin/index.js"
        },
        "./backoffice/admin/audit": {
            "types": "./dist/backoffice/admin/audit/index.d.ts",
            "default": "./dist/backoffice/admin/audit/index.js"
        },
        "./backoffice/admin/dashboard": {
            "types": "./dist/backoffice/admin/dashboard/index.d.ts",
            "default": "./dist/backoffice/admin/dashboard/index.js"
        },
        "./backoffice/admin/order": {
            "types": "./dist/backoffice/admin/order/index.d.ts",
            "default": "./dist/backoffice/admin/order/index.js"
        },
        "./backoffice/admin/product": {
            "types": "./dist/backoffice/admin/product/index.d.ts",
            "default": "./dist/backoffice/admin/product/index.js"
        },
        "./backoffice/admin/settings": {

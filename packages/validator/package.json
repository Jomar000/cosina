{
    "name": "@hyperion/validator",
    "version": "0.0.1",
    "author": "4thDEVisionTech",
    "description": "Hyperion Validator Component",
    "type": "module",
    "private": true,
    "license": "ISC",
    "engines": {
        "node": ">=24.14.0",
        "pnpm": ">=10.32.1"
    },
    "scripts": {
        "build": "tsc --build ./tsconfig.json",
        "format": "prettier --write .",
        "lint": "prettier --check . && eslint .",
        "prepare": "pnpm build"
    },
    "dependencies": {
        "@hyperion/types": "workspace:*",
        "dayjs": "catalog:",
        "zod": "catalog:"
    },
    "exports": {
        "./backoffice": {
            "types": "./dist/backoffice/index.d.ts",
            "default": "./dist/backoffice/index.js"
        },
        "./backoffice/auth": {
            "types": "./dist/backoffice/auth.schema.d.ts",
            "default": "./dist/backoffice/auth.schema.js"
        },
        "./backoffice/admin/user": {
            "types": "./dist/backoffice/admin/user/index.d.ts",
            "default": "./dist/backoffice/admin/user/index.js"
        },
        "./backoffice/objectStorage": {
            "types": "./dist/backoffice/objectStorage.schema.d.ts",
            "default": "./dist/backoffice/objectStorage.schema.js"
        },
        "./backoffice/user": {
            "types": "./dist/backoffice/user/index.d.ts",
            "default": "./dist/backoffice/user/index.js"
        },
        "./public": {
            "types": "./dist/public/index.d.ts",
            "default": "./dist/public/index.js"
        },
        "./public/auth": {
            "types": "./dist/public/auth.schema.d.ts",
            "default": "./dist/public/auth.schema.js"
        },
        "./public/admin/user": {
            "types": "./dist/public/admin/user/index.d.ts",
            "default": "./dist/public/admin/user/index.js"
        },
        "./public/objectStorage": {
            "types": "./dist/public/objectStorage.schema.d.ts",
            "default": "./dist/public/objectStorage.schema.js"
        },
        "./public/user": {
            "types": "./dist/public/user/index.d.ts",
            "default": "./dist/public/user/index.js"
        },
        "./shared": {
            "types": "./dist/shared/index.d.ts",
            "default": "./dist/shared/index.js"
        }
    }
}

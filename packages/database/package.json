{
    "name": "@hyperion/database",
    "version": "0.0.1",
    "author": "4thDEVisionTech",
    "description": "Hyperion Database Component",
    "type": "module",
    "private": true,
    "license": "ISC",
    "engines": {
        "bun": ">=1.3.10",
        "node": ">=24.14.0",
        "pnpm": ">=10.31.0"
    },
    "scripts": {
        "build": "tsc --build ./tsconfig.build.json",
        "format": "prettier --write .",
        "lint": "prettier --check . && eslint .",
        "migrate:dev": "bun --env-file=.env ./src/postgres/bootstrap.ts || tsx --env-file=.env ./src/postgres/bootstrap.ts",
        "migrate:test": "bun --env-file=.env.test ./src/postgres/bootstrap.ts || tsx --env-file=.env.test ./src/postgres/bootstrap.ts",
        "migrate:staging": "drizzle-kit migrate --config=drizzle-staging.config.ts",
        "migrate:prod": "drizzle-kit migrate --config=drizzle-production.config.ts",
        "prepare": "pnpm build"
    },
    "dependencies": {
        "drizzle-orm": "catalog:",
        "postgres": "^3.4.8",
        "uuid": "catalog:"
    },
    "devDependencies": {
        "drizzle-kit": "catalog:"
    },
    "exports": {
        "./postgres": {
            "types": "./dist/postgres/index.d.ts",
            "default": "./dist/postgres/index.js"
        }
    }
}

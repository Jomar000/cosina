{
    "name": "@hyperion/database",
    "version": "0.0.1",
    "author": "4thDEVisionTech",
    "description": "Hyperion Database Component",
    "type": "module",
    "private": true,
    "license": "ISC",
    "engines": {
        "node": ">=26.4.0",
        "pnpm": ">=11.9.0"
    },
    "scripts": {
        "build": "tsc --build ./tsconfig.build.json",
        "build:force": "tsc --build ./tsconfig.build.json --clean && pnpm run build",
        "cleanup:test": "tsx --env-file=.env.test ./src/postgres/bootstrap.ts --cleanup-stale-tests",
        "format": "eslint . --fix && prettier --write . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
        "lint": "prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore && eslint .",
        "migrate:dev": "tsx --env-file=.env ./src/postgres/bootstrap.ts",
        "migrate:prod": "drizzle-kit migrate --config=drizzle-production.config.ts",
        "migrate:staging": "drizzle-kit migrate --config=drizzle-staging.config.ts",
        "migrate:test": "tsx --env-file=.env.test ./src/postgres/bootstrap.ts",
        "prepare": "pnpm build"
    },
    "dependencies": {
        "drizzle-orm": "catalog:",
        "postgres": "catalog:",
        "uuid": "catalog:"
    },
    "devDependencies": {
        "drizzle-kit": "catalog:"
    },
    "exports": {
        "./postgres": {
            "types": "./dist/postgres/index.d.ts",
            "default": "./dist/postgres/index.js"
        }
    }
}

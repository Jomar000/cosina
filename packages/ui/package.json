{
    "name": "@hyperion/ui",
    "version": "0.0.1",
    "author": "4thDEVisionTech",
    "description": "Hyperion UI Component Library (shadcn-svelte)",
    "type": "module",
    "private": true,
    "license": "ISC",
    "engines": {
        "node": ">=24.14.0",
        "pnpm": ">=10.32.1"
    },
    "scripts": {
        "build": "svelte-package",
        "check": "svelte-check --tsconfig ./tsconfig.json",
        "format": "prettier --write .",
        "lint": "prettier --check . && eslint .",
        "prepare": "pnpm build"
    },
    "exports": {
        "./components/*": {
            "types": "./dist/components/*/index.d.ts",
            "svelte": "./dist/components/*/index.js",
            "default": "./dist/components/*/index.js"
        },
        "./hooks": {
            "types": "./dist/hooks/index.d.ts",
            "default": "./dist/hooks/index.js"
        },
        "./shared/*": {
            "types": "./dist/shared/*/index.d.ts",
            "svelte": "./dist/shared/*/index.js",
            "default": "./dist/shared/*/index.js"
        },
        "./styles": "./dist/styles/globals.css",
        "./utils": {
            "types": "./dist/utils.d.ts",
            "default": "./dist/utils.js"
        }
    },
    "files": [
        "dist",
        "!dist/**/*.test.*",
        "!dist/**/*.spec.*"
    ],
    "devDependencies": {
        "@internationalized/date": "catalog:",
        "@lucide/svelte": "catalog:",
        "@sveltejs/package": "^2.5.7",
        "@sveltejs/vite-plugin-svelte": "catalog:",
        "@tanstack/table-core": "catalog:",
        "bits-ui": "catalog:",
        "clsx": "catalog:",
        "embla-carousel-svelte": "^8.6.0",
        "formsnap": "^2.0.1",
        "layerchart": "2.0.0-next.43",
        "mode-watcher": "catalog:",
        "paneforge": "^1.0.2",
        "shadcn-svelte": "^1.2.3",
        "svelte": "catalog:",
        "svelte-check": "catalog:",
        "svelte-sonner": "catalog:",
        "sveltekit-superforms": "^2.30.0",
        "tailwind-merge": "catalog:",
        "tailwind-variants": "catalog:",
        "tailwindcss": "catalog:",
        "tw-animate-css": "catalog:",
        "vaul-svelte": "1.0.0-next.7"
    },
    "peerDependencies": {
        "svelte": "^5.0.0"
    }
}

#!/usr/bin/env bash

echo
echo ==============================
echo = BEGIN: git post-merge hook =
echo ==============================
echo

# Check if dependency files were modified
depsChanged=$(git diff --name-only ORIG_HEAD HEAD | (grep -E 'package\.json|pnpm-lock\.yaml|pnpm-workspace\.yaml' || true))

if [[ $depsChanged != '' ]]; then
    echo "Installing project dependencies..."
    pnpm -r i
    echo
fi

# Check if any relevant source or config files were modified
tsFilesChanged=$(git diff --name-only ORIG_HEAD HEAD | (grep -E 'packages/(types|validator|database)/src/|apps/(api-public|api-backoffice)/src/|tsconfig' || true))

if [[ $tsFilesChanged != '' ]]; then
    echo "Rebuilding TypeScript project graph..."
    pnpm exec tsc --build ./tsconfig.json --clean
    pnpm exec tsc --build ./tsconfig.json
    echo
fi

echo ============================
echo = END: git post-merge hook =
echo ============================
echo

exit 0

{
    "compilerOptions": {
        /* Language and Environment */
        "target": "esnext",

        /* Modules */
        "module": "nodenext",
        "moduleResolution": "nodenext",

        /* JavaScript Support */
        "allowJs": true,
        "checkJs": true,

        /* Emit */
        "declaration": true,
        "removeComments": true,
        "noEmitOnError": true,

        /* Interop Constraints */
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,

        /* Type Checking */
        "strict": true,

        /* Completeness */
        "skipLibCheck": true,

        /* Projects */
        "composite": true
    }
}
